<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyCAP</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.JellyCAP</AssemblyName>
    <Version>0.1.0.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Authors>KristopherPeck</Authors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KristopherPeck/JellyCAP</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Web\dashboard.html" />
    <EmbeddedResource Include="Web\dashboard.html" />
  </ItemGroup>

  <Target Name="RejectBundledSqliteNativeRuntime" AfterTargets="Publish">
    <ItemGroup>
      <BundledSqliteNativeRuntime Include="$(PublishDir)**\e_sqlite3.dll;$(PublishDir)**\libe_sqlite3.so;$(PublishDir)**\libe_sqlite3.dylib" />
    </ItemGroup>
    <Error
      Condition="'@(BundledSqliteNativeRuntime)' != ''"
      Text="JellyCAP must use Jellyfin's native SQLite runtime; remove bundled e_sqlite3 native assets from the publish output." />
  </Target>
</Project>

